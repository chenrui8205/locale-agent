# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Anthropic (https://console.anthropic.com -> Settings -> API Keys)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Models — all-Haiku for now (thrifty). Intent + synthesis both on Haiku.
INTENT_MODEL=claude-haiku-4-5
SYNTHESIS_MODEL=claude-haiku-4-5

# Postgres (matches docker-compose.yml). Async driver = asyncpg.
DATABASE_URL=postgresql+asyncpg://locale:locale@localhost:5432/locale

# Redis
REDIS_URL=redis://localhost:6379/0

# Nominatim requires a real User-Agent with contact info (their ToS).
NOMINATIM_USER_AGENT=locale-agent/0.1 (you@example.com)

# Reddit is sourced via Apify (official Reddit API is gated behind approval).
# Token: apify.com -> Settings -> Integrations -> API token. Free plan ~$5/mo
# credit (~1k posts). Leave blank to skip Reddit (adapter no-ops + adds a note).
APIFY_TOKEN=
APIFY_REDDIT_ACTOR=practicaltools/apify-reddit-api

# Guardrails
COST_CAP_EXTERNAL_CALLS=12

LOG_LEVEL=INFO
